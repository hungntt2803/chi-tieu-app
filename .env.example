# Copy sang .env.local (local) hoặc thêm trên Vercel → Settings → Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# URL công khai của app (dùng cho mã QR). Nếu bỏ trống, QR dùng domain đang mở.
# NEXT_PUBLIC_APP_URL=https://chi-tieu-app.vercel.app

# (tuỳ chọn, tương thích tên cũ)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
